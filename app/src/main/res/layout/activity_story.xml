<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/storyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stella1_1">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/storyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp"
            android:background="#CC111827">

            <TextView
                android:id="@+id/txtStoryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="하늘섬의 항해사"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtStoryType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이루지 못한 꿈"
                android:textColor="#C9C3FF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <ImageView
                android:id="@+id/imgStory"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:layout_marginTop="20dp"
                android:scaleType="centerCrop"
                android:src="@drawable/stella_star1" />

            <TextView
                android:id="@+id/txtStoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="낡은 항해 일지"
                android:textColor="#C9C3FF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="26dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#55C9C3FF" />

            <TextView
                android:id="@+id/txtStoryBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이곳에는 누군가의 꿈이 남아 있습니다."
                android:textColor="#E5E7EB"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp"
                android:layout_marginTop="18dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="26dp"
                android:background="#55C9C3FF" />

            <TextView
                android:id="@+id/txtStoryMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="꿈은 이루어지지 않아도\n사라지지 않습니다."
                android:textColor="#DAD7FF"
                android:textSize="17sp"
                android:textStyle="italic"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:layout_marginTop="22dp" />

            <Button
                android:id="@+id/btnGoResult"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="12dp"
                android:text="별의 흔적을 기록합니다."
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#6D5DF6" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>