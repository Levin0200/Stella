<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/starSelectRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stella1_1">

    <LinearLayout
        android:id="@+id/starCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#CC111827"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtStarTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="꿈의 흔적을 선택하세요"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/txtStarSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="별빛 사이에서 다섯 개의 이야기가 당신을 기다립니다."
            android:textColor="#DAD7FF"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp" />

        <Spinner
            android:id="@+id/spinnerDream"
            android:layout_width="240dp"
            android:layout_height="320dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="30dp"
            android:background="@android:color/transparent"
            android:dropDownWidth="240dp"
            android:popupBackground="#111827"
            />


        <TextView
            android:id="@+id/txtDreamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="별빛 대장장이"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/txtDreamType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="못 이룬 꿈"
            android:textColor="#C9C3FF"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txtDreamDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="평생 왕국 최고의 검을 만들고 싶었던 대장장이의 흔적입니다."
            android:textColor="#E5E7EB"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnFollowDream"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="이 흔적을 따라간다"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:backgroundTint="#6D5DF6" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>