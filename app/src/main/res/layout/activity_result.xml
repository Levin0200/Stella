<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/resultRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stella1_1">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingBottom="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="28dp"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="36dp"
            android:background="#CC111827">

            <TextView
                android:id="@+id/txtResultHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="별의 흔적이 기록되었습니다."
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageView
                android:id="@+id/imgResultStar"
                android:layout_width="match_parent"
                android:layout_height="450dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:src="@drawable/stella_star1"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/txtResultTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="하늘섬의 항해사"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/txtResultType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이루지 못한 꿈"
                android:textColor="#C9C3FF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="22dp"
                android:background="#55C9C3FF" />

            <TextView
                android:id="@+id/txtResultMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="꿈은 이루어지지 않아도\n사라지지 않습니다."
                android:textColor="#E5E7EB"
                android:textSize="17sp"
                android:gravity="center"
                android:lineSpacingExtra="7dp"
                android:layout_marginTop="22dp" />

            <TextView
                android:id="@+id/txtResultCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="현재 기록한 별 1 / 5"
                android:textColor="#DAD7FF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="26dp" />

            <Button
                android:id="@+id/btnBackToStars"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="다음 꿈의 흔적을 찾는다"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#6D5DF6" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>